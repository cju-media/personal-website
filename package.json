{
  "name": "cju-media-site",
  "version": "1.0.0",
  "description": "cju.media — static rebuild off Squarespace",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy",
    "clean": "rm -rf _site",
    "deploy": "npm run clean && eleventy && wrangler deploy"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "wrangler": "4.131.2"
  }
}
